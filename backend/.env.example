# Copy to .env and fill values
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
JWT_ACCESS_SECRET=replace-with-32-char-min
JWT_REFRESH_SECRET=replace-with-32-char-min
JWT_RESET_SECRET=replace-with-32-char-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:5173

# Firebase service account (JSON string) - optional for social login
# FIREBASE_SERVICE_ACCOUNT={...}

# SMTP (optional) - if not set, reset emails are logged to console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# ============================================================================
# Backend environment
# ============================================================================
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baseweb?schema=public

# JWT secrets (TUYỆT ĐỐI đổi khi deploy production, dùng chuỗi random >= 32 ký tự)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS: danh sách origin được phép, phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
