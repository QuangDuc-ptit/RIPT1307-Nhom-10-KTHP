// Prisma schema
// Tài liệu: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  avatar       String?
  provider     String?
  providerId   String?
  posts        Post[]
  refreshTokens RefreshToken[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  showtimeSeats ShowtimeSeat[]
  bookings     Booking[]
  staffLogs    StaffLog[]

  @@unique([provider, providerId])
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  excerpt    String?
  coverImage String?
  published  Boolean  @default(false)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, createdAt])
  @@index([authorId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum SeatType {
  NORMAL
  VIP
  SWEETBOX
}

model Cinema {
  id        String   @id @default(cuid())
  name      String
  address   String
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id        String   @id @default(cuid())
  name      String
  cinemaId  String
  cinema    Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats     Seat[]
  showtimes Showtime[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seat {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  row       String
  number    Int
  type      SeatType @default(NORMAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  showtimeSeats ShowtimeSeat[]

  @@unique([roomId, row, number])
}

model Movie {
  id        String      @id @default(cuid())
  title     String
  poster    String?
  backdrop  String?
  overview  String?
  duration  Int?        // minutes
  releaseDate DateTime?
  status    MovieStatus @default(DRAFT)
  isActive  Boolean     @default(true)
  translations MovieTranslation[]
  genres     MovieGenre[]
  showtimes  Showtime[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum MovieStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model MovieTranslation {
  id        String   @id @default(cuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  locale    String             // 'vi' | 'en'
  title     String
  overview  String?

  @@unique([movieId, locale])
  @@index([locale])
}

model Genre {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  movies    MovieGenre[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model MovieGenre {
  id       String  @id @default(cuid())
  movieId  String
  movie    Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genreId  String
  genre    Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([movieId, genreId])
}

model Showtime {
  id        String         @id @default(cuid())
  movieId   String
  movie     Movie          @relation(fields: [movieId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startTime DateTime
  seats     ShowtimeSeat[]
  bookings  Booking[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
}

model ShowtimeSeat {
  id         String     @id @default(cuid())
  showtimeId String
  showtime   Showtime   @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatId     String
  seat       Seat       @relation(fields: [seatId], references: [id], onDelete: Cascade)
  
  status     SeatStatus @default(AVAILABLE)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])
  
  expiresAt  DateTime?
  version    Int        @default(1)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  
  bookingSeats BookingSeat[]

  @@unique([showtimeId, seatId])
}

enum BookingStatus {
  PENDING
  SUCCESS
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  showtimeId  String
  showtime    Showtime      @relation(fields: [showtimeId], references: [id])
  totalAmount Float         @default(0)
  status      BookingStatus @default(PENDING)
  isCheckedIn Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  bookingSeats BookingSeat[]
  bookingFoods BookingFood[]
  staffLogs    StaffLog[]
}

model BookingSeat {
  id             String       @id @default(cuid())
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showtimeSeatId String
  showtimeSeat   ShowtimeSeat @relation(fields: [showtimeSeatId], references: [id])
  price          Float
}

model Food {
  id           String        @id @default(cuid())
  name         String
  price        Float
  description  String?
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookingFoods BookingFood[]
}

model BookingFood {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food    @relation(fields: [foodId], references: [id])
  quantity  Int
  price     Float
}

model StaffLog {
  id        String   @id @default(cuid())
  staffId   String
  staff     User     @relation(fields: [staffId], references: [id])
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  action    String   @default("CHECK_IN")
  createdAt DateTime @default(now())
}
