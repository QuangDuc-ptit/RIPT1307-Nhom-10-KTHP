{
  "name": "base-web-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider umi dev --port 8001",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider umi build",
    "preview": "cross-env NODE_OPTIONS=--openssl-legacy-provider umi preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
