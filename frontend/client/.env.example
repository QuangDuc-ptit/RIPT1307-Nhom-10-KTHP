# API base URL (backend). Khi để rỗng, code sẽ dùng /api kèm proxy của Vite (xem vite.config.ts).
VITE_API_BASE_URL=http://localhost:4000/api

# Tuỳ chọn: bật proxy của Vite (chuyển /api -> target này) để tránh CORS khi dev
# Khi set, code có thể dùng VITE_API_BASE_URL=/api
VITE_PROXY_API=

# Tên app hiển thị
VITE_APP_NAME=Base Web

# Khoá lưu token trong localStorage
VITE_TOKEN_KEY=base_web_client_token
VITE_REFRESH_TOKEN_KEY=base_web_client_refresh_token
